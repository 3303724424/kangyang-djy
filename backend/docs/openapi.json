{
  "openapi": "3.1.0",
  "info": {
    "title": "都江堰银龄康养旅居智能体 API",
    "description": "本地 Qwen + RAG + 规则规划接口。响应使用 frontend_payload，适合前端直接渲染时间线卡片。",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/frontend-contract": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Frontend Contract",
        "operationId": "frontend_contract_api_v1_frontend_contract_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Frontend Contract Api V1 Frontend Contract Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/travel/plan": {
      "post": {
        "tags": [
          "travel"
        ],
        "summary": "生成银龄康养旅居行程",
        "operationId": "create_travel_plan_api_v1_travel_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TravelPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "可由前端直接渲染的结构化行程 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TravelPlanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TravelPlanRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 2,
            "title": "Question",
            "description": "用户的自然语言需求"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name",
            "description": "称呼，仅用于温暖文案",
            "default": "体验用户"
          },
          "age_group": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Age Group",
            "description": "年龄段，例如：70-79岁",
            "default": "70-79岁"
          },
          "days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Days",
            "description": "行程天数；Demo 目前支持 1-7 天",
            "default": 3
          },
          "travelers": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Travelers",
            "description": "同行人数",
            "default": 1
          },
          "budget": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Budget",
            "description": "预算，仅用于候选筛选，不代表报价",
            "default": 1800
          },
          "mobility": {
            "type": "string",
            "enum": [
              "可轻松步行",
              "需要减少步行",
              "需轮椅协助"
            ],
            "title": "Mobility",
            "description": "行动能力，用于控制强度",
            "default": "需要减少步行"
          },
          "preferences": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferences",
            "description": "偏好标签，如 [\"文化讲解\", \"温泉\"]"
          },
          "travel_date": {
            "type": "string",
            "maxLength": 50,
            "title": "Travel Date",
            "description": "出行日期，当前仅展示给规划逻辑，不校验实时天气",
            "default": ""
          },
          "needs_student_guide": {
            "type": "boolean",
            "title": "Needs Student Guide",
            "description": "是否需要平台学生导游陪伴候选",
            "default": false
          },
          "wellness_mode": {
            "type": "string",
            "enum": [
              "not_needed",
              "recommend_only",
              "selected"
            ],
            "title": "Wellness Mode",
            "description": "not_needed=不展示；recommend_only=仅候选；selected=已选项目后才尝试排入行程",
            "default": "recommend_only"
          },
          "wellness_categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Wellness Categories",
            "description": "用户已选的康养类别，如 [\"温泉\", \"营养餐\"]；仅 selected 时用于排程"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "TravelPlanRequest",
        "description": "Parameters collected by the frontend before planning a trip."
      },
      "TravelPlanResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "请求追踪 ID"
          },
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "generated_at": {
            "type": "string",
            "title": "Generated At",
            "description": "UTC 生成时间"
          },
          "frontend_payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Frontend Payload",
            "description": "前端渲染专用数据；不要解析 LLM 原始文字"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "generated_at",
          "frontend_payload"
        ],
        "title": "TravelPlanResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
